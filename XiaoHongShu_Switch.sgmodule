#!name=小红书-投手广告放行开关
#!desc=【勾选点亮】立即进入投手模式，所有小红书广告与聚光后台全面放行；【平时关闭】保持纯净去广告。
#!category=业务

[Rule]
# 顶层优先：全量放行小红书所有域名与广告，禁止拦截
DOMAIN-SUFFIX,ad.xiaohongshu.com,DIRECT
DOMAIN-SUFFIX,business.xiaohongshu.com,DIRECT
DOMAIN-SUFFIX,xiaohongshu.com,DIRECT
DOMAIN-SUFFIX,xhscdn.com,DIRECT
DOMAIN-SUFFIX,xhscdn.net,DIRECT

[MITM]
# 强制跳过解密，保证广告数据完整与后台正常登录
hostname = -*.xiaohongshu.com, -*.xhscdn.com, -*.xhscdn.net
